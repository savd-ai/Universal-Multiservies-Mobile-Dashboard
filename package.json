{
  "name": "savd-google-ads-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "SAVD Ads Intelligence — a customizable, read-only Google Ads dashboard with plugins, anomaly alerts, budget planning and AI suggestions. Falls back to demo data when .env is incomplete.",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:example": "node --conditions=react-server --import tsx scripts/gen-env-example.ts",
    "decode-reference": "node scripts/decode-reference.mjs",
    "parity:prepare": "node scripts/parity-prepare.mjs",
    "plugin:new": "node scripts/create-plugin.mjs",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "check:google-ads": "tsx scripts/check-google-ads.ts",
    "google-ads:auth": "tsx scripts/google-ads-auth.ts",
    "reconcile:live": "tsx scripts/reconcile-live.ts",
    "warehouse": "tsx scripts/warehouse.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "gen:key": "node scripts/gen-encryption-key.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "docs:docx": "node scripts/docs-docx.mjs",
    "docs:diagrams": "node scripts/render-diagrams.mjs",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "^6.1.0",
    "next": "16.3.7",
    "nuqs": "^2.10.1",
    "openai": "^7.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.30.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^26.1.0",
    "mermaid": "^11.17.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^5.0.2"
  }
}
