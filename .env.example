# SAVD Ads Intelligence — environment
# Copy to .env and fill in what you have. Anything incomplete falls back to demo data with a visible reason.
# Generated by `npm run env:example` from src/lib/server/env/registry.ts — do not edit by hand.

# ── Google Ads API (all 4 required keys → live data; otherwise demo data) ──
# OAuth 2.0 client id from the Google Cloud project with Google Ads API access (Explorer or higher for production accounts). (required for live)
GOOGLE_ADS_CLIENT_ID=
# OAuth 2.0 client secret. (required for live)
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token with the https://www.googleapis.com/auth/adwords scope. (required for live)
GOOGLE_ADS_REFRESH_TOKEN=
# Default client account id (dashes allowed), e.g. 482-119-3307. (required for live)
GOOGLE_ADS_CUSTOMER_ID=
# Optional legacy developer token. Google sunset developer tokens on 2026-09-09: the header is still sent when set but ignored — access levels come from the Google Cloud project that owns the OAuth client.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) id — sent as login-customer-id and enables the account switcher.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# REST API version. Default: v25
GOOGLE_ADS_API_VERSION=
# Cache lifetime for hot (recent) report chunks. Default: 900
GOOGLE_ADS_CACHE_TTL_SECONDS=
# Recent days treated as hot because conversions restate. Default: 14
GOOGLE_ADS_RESTATEMENT_DAYS=
# Parallel Google Ads API requests. Default: 5
GOOGLE_ADS_MAX_CONCURRENCY=
# Per-request timeout. Default: 60000
GOOGLE_ADS_TIMEOUT_MS=
# Deep link used for read-only 'Open in Google Ads' actions. Default: https://ads.google.com/aw/campaigns?campaignId={campaignId}&ocid={customerId}
GOOGLE_ADS_UI_URL_TEMPLATE=
# Always show demo data, even when credentials exist. Default: false
DASHBOARD_FORCE_DEMO=

# ── Demo data ──
# realistic = stable data anchored to yesterday; prototype = the reference HTML's exact dataset (ends 2026-09-28). Default: realistic
DEMO_PROFILE=
# Seed for the demo generator. Default: savd-demo-v1
DEMO_SEED=
# Demo account time zone (the anchor is yesterday there). Default: America/New_York
DEMO_TIMEZONE=
# Demo account currency. Default: USD
DEMO_CURRENCY=
# Pin the last day of demo data (YYYY-MM-DD) for screenshots and tests.
DEMO_ANCHOR_DATE=
# extended = prototype anomalies + tracking break + budget-limited scenario; basic = prototype only. Default: extended
DEMO_SCENARIOS=

# ── AI providers (optional — demo suggestions without a key) ──
# auto | anthropic | openai | gemini | demo. auto picks the first provider with a key. Default: auto
AI_PROVIDER=
# Enables Claude.
ANTHROPIC_API_KEY=
# Claude model id. Default: claude-opus-5-5
ANTHROPIC_MODEL=
# Enables OpenAI.
OPENAI_API_KEY=
# OpenAI model id. Default: gpt-6-sol
OPENAI_MODEL=
# Enables Gemini.
GEMINI_API_KEY=
# Gemini model id. Default: gemini-3.8-flash
GEMINI_MODEL=
# Gemini model used when the main one is out of quota or unavailable (none = off). Flash-Lite has a much larger free-tier quota. Default: gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
# Override reasoning effort for every AI feature (low | medium | high).
AI_EFFORT=
# AI requests per minute per client. Default: 10
AI_RATE_LIMIT_PER_MIN=
# Daily cap on AI requests (cost guard). Default: 300
AI_DAILY_REQUEST_LIMIT=
# Parallel AI calls. Default: 3
AI_MAX_CONCURRENCY=
# Upstream AI timeout. Default: 120000
AI_TIMEOUT_MS=
# Always use the demo engine. Default: false
AI_DISABLED=

# ── Alert webhooks & scheduler ──
# Slack incoming webhook URL.
SLACK_WEBHOOK_URL=
# Microsoft Teams Workflows webhook URL (Office 365 connector URLs were retired in 2026).
TEAMS_WEBHOOK_URL=
# Discord webhook URL.
DISCORD_WEBHOOK_URL=
# Generic JSON webhook URL.
ALERT_WEBHOOK_URL=
# HMAC-SHA256 signing secret for the generic webhook (X-SAVD-Signature).
ALERT_WEBHOOK_SECRET=
# Evaluate alerts on a timer inside a long-running Node server. Default: false
ALERTS_SCHEDULER_ENABLED=
# Scheduler interval (minimum 5). Default: 60
ALERTS_INTERVAL_MINUTES=
# Allow real webhook sends while showing demo data. Default: false
ALERTS_DEMO_DISPATCH=
# Evaluate every accessible account under the manager (MCC), not just the active one. Default: false
ALERTS_ALL_ACCOUNTS=
# Let the configured AI provider write the daily digest summary (numbers stay server-computed). Default: false
ALERTS_DIGEST_AI=
# Bearer token for /api/cron/alerts (external cron).
CRON_SECRET=
# Public base URL used in alert links and the CSRF origin check. Default: http://localhost:3000
APP_BASE_URL=

# ── Plugins ──
# Allow custom plugins/webhooks to reach private network addresses (cloud metadata stays blocked). Default: false
PLUGINS_ALLOW_PRIVATE_NETWORK=
# Allow plain http:// endpoints. Default: false
PLUGINS_ALLOW_HTTP=
# Timeout for plugin and webhook requests. Default: 15000
PLUGINS_FETCH_TIMEOUT_MS=
# Response size cap for plugin requests. Default: 5242880
PLUGINS_MAX_RESPONSE_BYTES=
# Expose the mock ad platform used by tests and the plugin builder demo. Default: true in development
DEV_MOCK_PLATFORM=
# Reserved for a future live meta connector (demo data in v1; presence is reported only).
META_ADS_ACCESS_TOKEN=
# Reserved for a future live meta connector (demo data in v1; presence is reported only).
META_ADS_AD_ACCOUNT_ID=
# Reserved for a future live microsoft connector (demo data in v1; presence is reported only).
MICROSOFT_ADS_DEVELOPER_TOKEN=
# Reserved for a future live microsoft connector (demo data in v1; presence is reported only).
MICROSOFT_ADS_ACCOUNT_ID=
# Reserved for a future live tiktok connector (demo data in v1; presence is reported only).
TIKTOK_ADS_ACCESS_TOKEN=
# Reserved for a future live tiktok connector (demo data in v1; presence is reported only).
TIKTOK_ADS_ADVERTISER_ID=
# Reserved for a future live linkedin connector (demo data in v1; presence is reported only).
LINKEDIN_ADS_ACCESS_TOKEN=
# Reserved for a future live linkedin connector (demo data in v1; presence is reported only).
LINKEDIN_ADS_ACCOUNT_ID=
# Reserved for a future live amazon connector (demo data in v1; presence is reported only).
AMAZON_ADS_REFRESH_TOKEN=
# Reserved for a future live amazon connector (demo data in v1; presence is reported only).
AMAZON_ADS_PROFILE_ID=
# Reserved for a future live pinterest connector (demo data in v1; presence is reported only).
PINTEREST_ADS_ACCESS_TOKEN=
# Reserved for a future live pinterest connector (demo data in v1; presence is reported only).
PINTEREST_ADS_AD_ACCOUNT_ID=
# Reserved for a future live snapchat connector (demo data in v1; presence is reported only).
SNAPCHAT_ADS_ACCESS_TOKEN=
# Reserved for a future live snapchat connector (demo data in v1; presence is reported only).
SNAPCHAT_ADS_AD_ACCOUNT_ID=
# Reserved for a future live reddit connector (demo data in v1; presence is reported only).
REDDIT_ADS_ACCESS_TOKEN=
# Reserved for a future live reddit connector (demo data in v1; presence is reported only).
REDDIT_ADS_ACCOUNT_ID=
# Reserved for a future live ga4 connector (demo data in v1; presence is reported only).
GA4_PROPERTY_ID=
# Reserved for a future live ga4 connector (demo data in v1; presence is reported only).
GA4_SERVICE_ACCOUNT_JSON=
# Reserved for a future live shopify connector (demo data in v1; presence is reported only).
SHOPIFY_STORE_DOMAIN=
# Reserved for a future live shopify connector (demo data in v1; presence is reported only).
SHOPIFY_ADMIN_API_TOKEN=
# Reserved for a future live woocommerce connector (demo data in v1; presence is reported only).
WOOCOMMERCE_STORE_URL=
# Reserved for a future live woocommerce connector (demo data in v1; presence is reported only).
WOOCOMMERCE_CONSUMER_SECRET=
# Reserved for a future live google-sheets connector (demo data in v1; presence is reported only).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Reserved for a future live google-sheets connector (demo data in v1; presence is reported only).
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Reserved for a future live bigquery connector (demo data in v1; presence is reported only).
BIGQUERY_PROJECT_ID=
# Reserved for a future live bigquery connector (demo data in v1; presence is reported only).
BIGQUERY_SERVICE_ACCOUNT_JSON=

# ── Analytics warehouse (SQLite) ──
# Keep Google Ads data in a local SQLite warehouse for long-term analytics (needs Node.js 22.13+). Default: true
WAREHOUSE_ENABLED=
# Folder of the SQLite files (live.sqlite, demo.sqlite). Default: <DATA_DIR>/warehouse
WAREHOUSE_DIR=
# Serve settled days from the warehouse instead of asking Google again (false = store only). Default: true
WAREHOUSE_READS=
# Sync every accessible account on a timer inside a long-running Node server. Default: false
WAREHOUSE_SYNC_ENABLED=
# Sync interval (minimum 15). Default: 360
WAREHOUSE_SYNC_INTERVAL_MINUTES=
# How far back a sync fills each table (capped by what Google keeps: 37 months daily, 92 days hourly, 12 months search terms). Default: 400
WAREHOUSE_BACKFILL_DAYS=
# Google Ads API requests one sync may spend (Explorer access allows 2,880 operations a day). Default: 250
WAREHOUSE_SYNC_MAX_REQUESTS=
# Delete stored facts older than this many days (0 = keep everything). Default: 0
WAREHOUSE_RETENTION_DAYS=

# ── Security & storage ──
# required = everyone signs in (users, roles, client workspaces); off = no login, everyone is a local admin (local demos only). Default: required
AUTH_MODE=
# One-time code for creating the first admin on /setup. If unset, a random code is printed to the server log while no user exists.
AUTH_SETUP_TOKEN=
# Maximum session length in days. Default: 7
AUTH_SESSION_DAYS=
# Sign out after this many hours without activity. Default: 24
AUTH_IDLE_HOURS=
# How long invite and password-reset links stay valid. Default: 72
AUTH_INVITE_HOURS=
# off | agency | all — require an authenticator app (TOTP) for agency users or for everyone. Needs APP_ENCRYPTION_KEY. Default: off
AUTH_REQUIRE_2FA=
# OAuth client id (Web) for "Sign in with Google". Redirect URI: {APP_BASE_URL}/api/auth/google/callback.
AUTH_GOOGLE_CLIENT_ID=
# OAuth client secret for "Sign in with Google".
AUTH_GOOGLE_CLIENT_SECRET=
# Comma-separated Google Workspace domains (e.g. savd.ai) whose verified users may sign in without an invite; they join as agency members.
AUTH_GOOGLE_ALLOWED_DOMAINS=
# user:password — an extra HTTP Basic auth gate in front of every page and API route (optional; the app has its own login).
DASHBOARD_BASIC_AUTH=
# 32-byte key (base64 or hex) that encrypts secrets saved from the UI. Generate with `npm run gen:key`.
APP_ENCRYPTION_KEY=
# Use the first X-Forwarded-For hop for rate-limit keys. Default: false
TRUST_PROXY=
# Where the JSON store (and by default the warehouse) lives. Default: ./data
DATA_DIR=
# file | memory. Default: file
STORE_DRIVER=
# debug | info | warn | error. Default: info
LOG_LEVEL=

# ── Display ──
# Display currency override (defaults to the account currency).
DASHBOARD_CURRENCY=
# JSON map of display conversion rates from the account currency, e.g. {"VND":25400}. Default: {"VND":25400}
FX_RATES=
