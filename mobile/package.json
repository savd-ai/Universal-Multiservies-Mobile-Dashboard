{
  "name": "savd-ads-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "expo-background-task": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "description": "SAVD Ads mobile app: the Google Ads dashboard on iOS and Android, with notifications when anomalies are detected."
}
